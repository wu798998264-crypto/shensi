SHENSI_CLOUD_ENV=development
SHENSI_CLOUD_HOST=127.0.0.1
SHENSI_CLOUD_PORT=4280
SHENSI_CLOUD_PUBLIC_URL=https://api.hexing.studio/skill
SHENSI_CLOUD_ALLOWED_ORIGINS=https://hexing.studio,https://skill.hexing.studio,https://api.hexing.studio
SHENSI_CLOUD_DATA=/var/lib/shensi-skill-platform/state.json
SHENSI_CLOUD_SIGNING_KEY=/etc/shensi-skill-platform/signing-key.json
SHENSI_CLOUD_DATABASE_URL=postgresql://shensi_skill:<password>@127.0.0.1:5432/shensi_skill
SHENSI_CLOUD_POSTGRES_SSL=false
SHENSI_CLOUD_REDIS_URL=redis://127.0.0.1:6379/5
SHENSI_CLOUD_OSS_REGION=oss-cn-hangzhou
SHENSI_CLOUD_OSS_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com
SHENSI_CLOUD_OSS_BUCKET=shensi-skill-private
SHENSI_CLOUD_OSS_ROLE_NAME=shensi-skill-platform
SHENSI_CLOUD_CLAMDSCAN_PATH=clamdscan
# 固定后台账号，不可注册、找回或修改；账号值由服务端代码保留。
SHENSI_CLOUD_BOOTSTRAP_ADMIN_ACCOUNT=798998264
# 兼容旧部署变量；新部署不再从它读取账号。
SHENSI_CLOUD_BOOTSTRAP_ADMIN_EMAIL=
SHENSI_CLOUD_BOOTSTRAP_ADMIN_PASSWORD=
# 以下 READY 变量只保留兼容旧部署，不再作为生产健康依据；生产服务使用上面的真实探针。
SHENSI_CLOUD_POSTGRES_READY=false
SHENSI_CLOUD_OBJECT_STORAGE_READY=false
SHENSI_CLOUD_MALWARE_SCANNER_READY=false

# 神思邮箱验证码：先在服务器受限配置中填写秘密，再启用；不填不会影响密码登录。
SHENSI_CLOUD_EMAIL_LOGIN_ENABLED=false
SHENSI_CLOUD_SMTP_HOST=smtp.qq.com
SHENSI_CLOUD_SMTP_PORT=465
SHENSI_CLOUD_SMTP_USER=shensiforge@qq.com
SHENSI_CLOUD_SMTP_FROM_NAME=神思
# QQ SMTP 授权码，不是邮箱主密码；仅服务端保存，不提交仓库。
SHENSI_CLOUD_SMTP_PASSWORD=
# 独立的至少 32 字符随机秘密，用于验证码 HMAC；不要复用 SMTP 授权码。
SHENSI_CLOUD_EMAIL_CODE_SECRET=
# 按北京时间自然日计数，全站发信尝试硬上限；失败也计数，重启不清零。
SHENSI_CLOUD_EMAIL_DAILY_LIMIT=1000
# 只填直接连接此服务的可信反向代理 IP，逗号分隔；默认不信任 X-Real-IP。
SHENSI_CLOUD_TRUSTED_PROXY_IPS=
