# Local source-only repository. Unknown root paths are excluded by default.
/*
!/.gitignore
!/.gitattributes
!/.rgignore
!/AGENTS.md
!/package.json
!/package-lock.json
!/index.html
!/server.mjs
!/cloud-core.mjs
!/update-config.example.json
!/src/
!/scripts/
!/packaging/
/packaging/*
!/packaging/windows/
!/public/
/public/*
!/public/assets/
!/docs/
/docs/*
!/docs/protected-capabilities/
!/docs/agent-runtime-refactor.md

# Secrets, personal content, generated state and build output at every depth.
**/.env
**/.env.*
**/.npmrc
**/.codex/
**/.claude/
**/.opencode/
**/.shensi/
**/.tmp*/
**/node_modules/
**/runtime/
**/artifacts/
**/output/
**/dist/
**/release/
**/test-results/
**/coverage/
**/logs/
**/cache/
**/generated/
**/backups/
**/原始资料/
**/作品/
**/笔记/
**/*credentials*.json
**/*secrets*.json
**/auth.json
**/config.local.*
**/*.local.json
**/*.log
**/*.pfx
**/*.p12
**/*.pem
**/*.key
**/*.cer
